{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-chemistry.chemistry-profile",
  "title": "GAIA Chemistry Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "thinking", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-chemistry"},
    "module_id": {"const": "hum.know.basic.basic-chemistry.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "wet_lab_enabled": {"const": false},
    "thinking": {
      "type": "object",
      "additionalProperties": false,
      "required": ["particulate", "structure_property", "stoichiometry"],
      "properties": {
        "particulate": {"$ref": "#/$defs/score"},
        "structure_property": {"$ref": "#/$defs/score"},
        "stoichiometry": {"$ref": "#/$defs/score"}
      }
    },
    "visuospatial": {"$ref": "#/$defs/score"},
    "green": {"$ref": "#/$defs/score"},
    "science_subject_id": {"const": "hum.know.basic.basic-science"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
