{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-art-and-creativity.creativity-profile",
  "title": "GAIA Creative Literacy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "forms", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-art-and-creativity"},
    "module_id": {"const": "hum.know.basic.basic-art-and-creativity.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "delivers_art_therapy": {"const": false},
    "forms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["visual", "music", "drama", "dance"],
      "properties": {
        "visual": {"$ref": "#/$defs/score"},
        "music": {"$ref": "#/$defs/score"},
        "drama": {"$ref": "#/$defs/score"},
        "dance": {"$ref": "#/$defs/score"}
      }
    },
    "process": {"$ref": "#/$defs/score"},
    "aesthetics": {"$ref": "#/$defs/score"},
    "world_traditions": {"$ref": "#/$defs/score"},
    "digital_ai": {"$ref": "#/$defs/score"},
    "philosophy_subject_id": {"const": "hum.know.basic.basic-philosophy"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
