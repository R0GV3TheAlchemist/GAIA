{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-ethics-and-morality.ethics-profile",
  "title": "GAIA Ethical Literacy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "literacy", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-ethics-and-morality"},
    "module_id": {"const": "hum.know.basic.basic-ethics-and-morality.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "house_doctrine": {"const": false},
    "literacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theories", "psychology", "reasoning", "applied", "civilizational", "dilemmas"],
      "properties": {
        "theories": {"$ref": "#/$defs/score"},
        "psychology": {"$ref": "#/$defs/score"},
        "reasoning": {"$ref": "#/$defs/score"},
        "applied": {"$ref": "#/$defs/score"},
        "civilizational": {"$ref": "#/$defs/score"},
        "dilemmas": {"$ref": "#/$defs/score"}
      }
    },
    "foundations_literacy": {"$ref": "#/$defs/score"},
    "philosophy_subject_id": {"const": "hum.know.basic.basic-philosophy"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
