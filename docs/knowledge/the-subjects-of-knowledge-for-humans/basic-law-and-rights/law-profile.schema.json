{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-law-and-rights.law-profile",
  "title": "GAIA Law & Rights Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "capability", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-law-and-rights"},
    "module_id": {"const": "hum.know.basic.basic-law-and-rights.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "jurisdiction": {"type": "string"},
    "legal_advice_enabled": {"const": false},
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["know", "find", "use_path"],
      "properties": {
        "know": {"$ref": "#/$defs/score"},
        "find": {"$ref": "#/$defs/score"},
        "use_path": {"$ref": "#/$defs/score"}
      }
    },
    "civics_subject_id": {"const": "hum.know.basic.basic-civics"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
