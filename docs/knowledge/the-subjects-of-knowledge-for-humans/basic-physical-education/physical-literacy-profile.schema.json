{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-physical-education.physical-literacy-profile",
  "title": "GAIA Physical Literacy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "literacy", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-physical-education"},
    "module_id": {"const": "hum.know.basic.basic-physical-education.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "delivers_clinical_exercise": {"const": false},
    "literacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["motivation", "confidence", "competence", "knowledge"],
      "properties": {
        "motivation": {"$ref": "#/$defs/score"},
        "confidence": {"$ref": "#/$defs/score"},
        "competence": {"$ref": "#/$defs/score"},
        "knowledge": {"$ref": "#/$defs/score"}
      }
    },
    "fms": {"$ref": "#/$defs/score"},
    "fitness_knowledge": {"$ref": "#/$defs/score"},
    "safety": {"$ref": "#/$defs/score"},
    "health_subject_id": {"const": "hum.know.basic.basic-health-and-hygiene"},
    "nutrition_subject_id": {"const": "hum.know.basic.basic-nutrition"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
