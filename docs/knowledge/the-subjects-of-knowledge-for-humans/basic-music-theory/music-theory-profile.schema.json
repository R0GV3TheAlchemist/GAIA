{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-music-theory.music-theory-profile",
  "title": "GAIA Music Theory Literacy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "literacy", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-music-theory"},
    "module_id": {"const": "hum.know.basic.basic-music-theory.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "literacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch", "rhythm", "harmony", "ear", "notation"],
      "properties": {
        "pitch": {"$ref": "#/$defs/score"},
        "rhythm": {"$ref": "#/$defs/score"},
        "harmony": {"$ref": "#/$defs/score"},
        "ear": {"$ref": "#/$defs/score"},
        "notation": {"$ref": "#/$defs/score"}
      }
    },
    "form": {"$ref": "#/$defs/score"},
    "history": {"$ref": "#/$defs/score"},
    "technology": {"$ref": "#/$defs/score"},
    "art_subject_id": {"const": "hum.know.basic.basic-art-and-creativity"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
