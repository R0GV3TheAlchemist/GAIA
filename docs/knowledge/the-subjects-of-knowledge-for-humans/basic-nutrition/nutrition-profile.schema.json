{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-nutrition.nutrition-profile",
  "title": "GAIA Nutrition Literacy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "literacy", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-nutrition"},
    "module_id": {"const": "hum.know.basic.basic-nutrition.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "clinical_diet_prescription": {"const": false},
    "literacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["macros", "micros", "patterns", "food_literacy", "brain_food", "microbiome", "planetary", "myth_resistance"],
      "properties": {
        "macros": {"$ref": "#/$defs/score"},
        "micros": {"$ref": "#/$defs/score"},
        "patterns": {"$ref": "#/$defs/score"},
        "food_literacy": {"$ref": "#/$defs/score"},
        "brain_food": {"$ref": "#/$defs/score"},
        "microbiome": {"$ref": "#/$defs/score"},
        "planetary": {"$ref": "#/$defs/score"},
        "myth_resistance": {"$ref": "#/$defs/score"}
      }
    },
    "health_subject_id": {"const": "hum.know.basic.basic-health-and-hygiene"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
