{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hum.know.basic.basic-financial-literacy.financial-literacy-profile",
  "title": "GAIA Financial Literacy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["subject_id", "module_id", "literacy", "gate"],
  "properties": {
    "subject_id": {"const": "hum.know.basic.basic-financial-literacy"},
    "module_id": {"const": "hum.know.basic.basic-financial-literacy.m01"},
    "learner_id": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "jurisdiction": {"type": "string"},
    "delivers_financial_advice": {"const": false},
    "literacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledge", "attitude", "behavior_intent"],
      "properties": {
        "knowledge": {"$ref": "#/$defs/score"},
        "attitude": {"$ref": "#/$defs/score"},
        "behavior_intent": {"$ref": "#/$defs/score"}
      }
    },
    "pisa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "money_and_transactions": {"$ref": "#/$defs/score"},
        "planning_and_managing": {"$ref": "#/$defs/score"},
        "risk_and_reward": {"$ref": "#/$defs/score"},
        "financial_landscape": {"$ref": "#/$defs/score"}
      }
    },
    "math_money": {"$ref": "#/$defs/score"},
    "bias_awareness": {"$ref": "#/$defs/score"},
    "digital_safety": {"$ref": "#/$defs/score"},
    "economics_subject_id": {"const": "hum.know.basic.basic-economics"},
    "notes": {"type": "string"},
    "gate": {"type": "string", "enum": ["allow", "deny", "ask"]},
    "stored_in_vault": {"type": "boolean"}
  },
  "$defs": {
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "value": {"type": "number", "minimum": 0, "maximum": 1},
        "evidence": {"type": "string", "enum": ["T0", "T1_PROVISIONAL", "T2", "T3"]}
      }
    }
  }
}
